# Copy to /opt/osu-scout/.env (systemd) or ./.env (docker compose) and fill in. Never commit the real file.

# osu! OAuth app: https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# REQUIRED for a public site: imports need this token (X-Admin-Token header / the field on /import).
# Generate one with:  openssl rand -hex 32
SCOUT_ADMIN_TOKEN=

# Set to "off" to disable web imports completely (use the CLI instead).
# SCOUT_IMPORTS=off

# Where the database lives
SCOUT_DB=/opt/osu-scout/data/scout.db

# The API stays on localhost behind the Next.js proxy. (docker-compose overrides these.)
SCOUT_HOST=127.0.0.1
SCOUT_PORT=8001

# Origins allowed to call the API directly from a browser (the site itself uses the proxy, so this can stay narrow).
SCOUT_ALLOWED_ORIGINS=https://scout.example.com

# Interactive API docs at /api/docs (leave off in production)
# SCOUT_DOCS=1

# osu! API politeness (seconds between requests)
OSU_MIN_INTERVAL=1.0
