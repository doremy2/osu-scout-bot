# Docker Compose variant: replace scout.example.com with your domain.
scout.example.com {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	request_body {
		max_size 64KB
	}
}
